<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/library_header">
        <Preference
            android:clickable="true"
            app:iconSpaceReserved="false"
            app:key="@string/radio_folders_uri_key"
            app:title="@string/music_path_title"
            app:useSimpleSummaryProvider="true" />

        <Preference
            android:clickable="true"
            app:iconSpaceReserved="false"
            app:key="game_key_folder_uri"
            app:title="Game Key Directory (GTA IV / EFLC / GTA V)"
            app:summary="GTRadio does not include game keys. Tap to select a folder containing your own copy of GTAIV.exe, EFLC.exe, GTA5.exe, GTA5_Enhanced.exe, or extracted .dat key files." />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/theme_header">
        <SwitchPreference
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            android:key="@string/enable_dynamic_theme_key"
            android:summary="@string/enable_dynamic_theme_summary"
            android:title="@string/enable_dynamic_theme_title" />

        <Preference
            android:clickable="true"
            app:iconSpaceReserved="false"
            app:key="@string/dynamic_theme_uri_key"
            app:title="@string/dynamic_theme_path_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/playback_header"
        app:iconSpaceReserved="false"
        app:title="@string/playback_header">
        <SwitchPreference
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            android:key="@string/ads_enabled_preference_key"
            android:summary="@string/ads_enabled_summary"
            android:title="@string/ads_enabled_title" />

        <SwitchPreference
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            android:key="@string/weather_chatter_enabled_preference_key"
            android:summary="@string/weather_chatter_summary"
            android:title="@string/weather_chatter_enabled_title" />

        <SwitchPreference
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            android:key="@string/news_reports_preference_key"
            android:summary="@string/news_reports_summary"
            android:title="@string/news_reports_enabled_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/metadata_header"
        app:iconSpaceReserved="false"
        app:title="@string/metadata_header">
        <SwitchPreference
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            android:key="@string/show_song_metadata_key"
            android:summary="@string/show_song_metadata_summary"
            android:title="@string/show_song_metadata_title" />

        <SwitchPreference
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            android:key="@string/download_album_art_key"
            android:summary="@string/download_album_art_summary"
            android:title="@string/download_album_art_title" />

        <Preference
            android:clickable="true"
            app:iconSpaceReserved="false"
            app:key="@string/scan_album_art_key"
            app:title="@string/scan_album_art_title"
            app:summary="@string/scan_album_art_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/diagnostics_header"
        app:iconSpaceReserved="false"
        app:title="@string/diagnostics_header">
        <SwitchPreference
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            android:key="@string/verbose_logging_key"
            android:summary="@string/verbose_logging_summary"
            android:title="@string/verbose_logging_title" />

        <Preference
            android:clickable="true"
            app:iconSpaceReserved="false"
            app:key="@string/view_logs_key"
            app:title="@string/view_logs_title"
            app:summary="@string/view_logs_summary" />
    </PreferenceCategory>

</PreferenceScreen>
