<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/library_header">
        <Preference
            android:clickable="true"
            app:key="@string/radio_folders_uri_key"
            app:title="@string/music_path_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/playback_header">
        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/ads_enabled_preference_key"
            android:summary="@string/ads_enabled_summary"
            android:title="@string/ads_enabled_title" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/weather_chatter_enabled_preference_key"
            android:summary="@string/weather_chatter_summary"
            android:title="@string/weather_chatter_enabled_title" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/news_reports_preference_key"
            android:summary="@string/news_reports_summary"
            android:title="@string/news_reports_enabled_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/metadata_header">
        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/show_song_metadata_key"
            android:summary="@string/show_song_metadata_summary"
            android:title="@string/show_song_metadata_title" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/download_album_art_key"
            android:summary="@string/download_album_art_summary"
            android:title="@string/download_album_art_title" />

        <Preference
            android:clickable="true"
            app:key="@string/scan_album_art_key"
            app:title="@string/scan_album_art_title"
            app:summary="@string/scan_album_art_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/diagnostics_header">
        <Preference
            android:clickable="true"
            app:key="@string/view_logs_key"
            app:title="@string/view_logs_title"
            app:summary="@string/view_logs_summary" />
    </PreferenceCategory>

</PreferenceScreen>
