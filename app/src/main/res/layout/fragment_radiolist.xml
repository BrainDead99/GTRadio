<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RadioList">

    <!-- Standard GTRadio Layout (Fallback when Dynamic Theme is off or unavailable) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/defaultRadioContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/station_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/nowPlaying"
            app:layout_constraintTop_toTopOf="parent" />

        <fragment
            android:id="@+id/nowPlaying"
            android:name="com.sc.gtradio.NowPlayingFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout="@layout/fragment_nowplaying" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fullscreen Dynamic Theme Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dynamicThemeRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <ImageView
            android:id="@+id/themeBgA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/themeBgB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.0"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <!-- Series Header Title (e.g. San Andreas Radio / Liberty City Radio) -->
        <TextView
            android:id="@+id/themeHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="Liberty City Radio"
            android:textColor="#D49A2A"
            android:textSize="32sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Top-Left NOW PLAYING Metadata Block -->
        <LinearLayout
            android:id="@+id/themeNowPlayingGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/themeHeaderTitle">

            <TextView
                android:id="@+id/themeNowPlayingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="NOW PLAYING"
                android:textColor="#D49A2A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/themeSongArt"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="#0A0A0A"
                android:scaleType="fitCenter"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/themeSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textColor="#D49A2A"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="KILLING IN THE NAME" />

            <TextView
                android:id="@+id/themeSongArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textColor="#D49A2A"
                android:textSize="13sp"
                tools:text="RAGE AGAINST THE MACHINE" />

            <TextView
                android:id="@+id/themeSongAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textColor="#D49A2A"
                android:textSize="13sp"
                tools:text="RAGE AGAINST THE MACHINE" />
        </LinearLayout>

        <!-- Centered Radio Controls & 2-Row Icon Grid -->
        <LinearLayout
            android:id="@+id/themeControlsBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/themeNowPlayingGroup">

            <TextView
                android:id="@+id/themeRadioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="RADIO"
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/themeRadioState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:letterSpacing="0.1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:text="OFF"
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/themeVolumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.1"
                android:text="VOLUME"
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.sc.gtradio.VolumeBarView
                android:id="@+id/themeVolumeBar"
                android:layout_width="180dp"
                android:layout_height="22dp"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:id="@+id/themeIconRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="8dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/themeIconRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/themeRadioStationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.1"
                android:text="RADIO STATION"
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/themeActiveStationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text=""
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Left-Aligned Two-Column Pause Menu Controls & Horizontal Scrolling Station Strip -->
        <LinearLayout
            android:id="@+id/themeStripControlsBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/themeNowPlayingGroup">

            <!-- Row 1: Radio | On/Off -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/themeStripRadioLabel"
                    android:layout_width="152dp"
                    android:layout_height="wrap_content"
                    android:text="Radio"
                    android:textColor="#D49A2A"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/themeStripRadioState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="2dp"
                    android:paddingEnd="16dp"
                    android:text="Off"
                    android:textColor="#8E8E8E"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Row 2: Audio Level | Continuous Horizontal Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/themeStripVolumeLabel"
                    android:layout_width="152dp"
                    android:layout_height="wrap_content"
                    android:text="Audio Level"
                    android:textColor="#D49A2A"
                    android:textSize="18sp" />

                <com.sc.gtradio.VolumeBarView
                    android:id="@+id/themeStripVolumeBar"
                    android:layout_width="150dp"
                    android:layout_height="18dp" />
            </LinearLayout>

            <!-- Row 3: Radio Station | Station Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/themeStripStationLabel"
                    android:layout_width="152dp"
                    android:layout_height="wrap_content"
                    android:text="Radio Station"
                    android:textColor="#D49A2A"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/themeStripActiveStationName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text=""
                    android:textColor="#D49A2A"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Horizontal Scrolling Station Icons Row -->
            <HorizontalScrollView
                android:id="@+id/themeStripIconScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/themeStripIconRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

        </LinearLayout>

        <!-- Circular Wheel & One-Handed Arc Theme Stage -->
        <FrameLayout
            android:id="@+id/themeWheelStage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/themeSettingsContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/themeHeaderTitle">

            <com.sc.gtradio.RadioWheelView
                android:id="@+id/themeRadioWheel"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/themeWheelMetaContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <com.sc.gtradio.OutlinedMarqueeTextView
                    android:id="@+id/themeWheelNowPlaying"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="4dp"
                    android:text="NOW PLAYING"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/themeWheelArt"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="#0A0A0A"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription" />

                <com.sc.gtradio.OutlinedMarqueeTextView
                    android:id="@+id/themeWheelStation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Station Name" />

                <com.sc.gtradio.OutlinedMarqueeTextView
                    android:id="@+id/themeWheelTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Song Title" />

                <com.sc.gtradio.OutlinedMarqueeTextView
                    android:id="@+id/themeWheelArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    tools:text="Artist" />

                <com.sc.gtradio.OutlinedMarqueeTextView
                    android:id="@+id/themeWheelAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    tools:text="Album Name" />

                <com.sc.gtradio.OutlinedMarqueeTextView
                    android:id="@+id/themeWheelOffLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:text="Radio Off"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Native Code-Drawn Live Settings Card -->
        <LinearLayout
            android:id="@+id/themeSettingsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <FrameLayout
                android:id="@+id/themeSettingsTabRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/themeSettingsTab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:background="#FFFFFFFF"
                    android:minWidth="96dp"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/themeSettingsTabAccent"
                        android:layout_width="match_parent"
                        android:layout_height="3.5dp"
                        android:background="#5EC2F2" />

                    <TextView
                        android:id="@+id/themeSettingsTabLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:letterSpacing="0.06"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"
                        android:text="SETTINGS"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/themeSettingsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#C2000000"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/themeSettingsVolumeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Radio Volume"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <com.sc.gtradio.VolumeBarView
                        android:id="@+id/themeSettingsVolumeBar"
                        android:layout_width="124dp"
                        android:layout_height="18dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/themeSettingsLoudnessRow"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/themeSettingsLoudnessLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Loudness Normalization"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/themeSettingsLoudnessValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&lt; On &gt;"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/themeSettingsEqRow"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/themeSettingsEqLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Car Stereo EQ"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/themeSettingsEqValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&lt; Off &gt;"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/themeSettingsWheelSideRow"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/themeSettingsWheelSideLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Wheel Layout"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/themeSettingsWheelSideValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&lt; Left &gt;"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/themeSettingsBottomReserve"
                android:layout_width="match_parent"
                android:layout_height="36dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
