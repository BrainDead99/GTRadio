<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RadioList">

    <!-- Standard GTRadio Layout (Fallback when Dynamic Theme is off or unavailable) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/defaultRadioContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/station_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/nowPlaying"
            app:layout_constraintTop_toTopOf="parent" />

        <fragment
            android:id="@+id/nowPlaying"
            android:name="com.sc.gtradio.NowPlayingFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout="@layout/fragment_nowplaying" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fullscreen Dynamic Theme Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dynamicThemeRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <ImageView
            android:id="@+id/themeBgA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/themeBgB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.0"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <!-- Series Header Title (e.g. San Andreas Radio / Liberty City Radio) -->
        <TextView
            android:id="@+id/themeHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="Liberty City Radio"
            android:textColor="#D49A2A"
            android:textSize="32sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Top-Left NOW PLAYING Metadata Block -->
        <LinearLayout
            android:id="@+id/themeNowPlayingGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/themeHeaderTitle">

            <TextView
                android:id="@+id/themeNowPlayingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="NOW PLAYING"
                android:textColor="#D49A2A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/themeSongArt"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="#0A0A0A"
                android:scaleType="fitCenter"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/themeSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textColor="#D49A2A"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="KILLING IN THE NAME" />

            <TextView
                android:id="@+id/themeSongArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textColor="#D49A2A"
                android:textSize="13sp"
                tools:text="RAGE AGAINST THE MACHINE" />

            <TextView
                android:id="@+id/themeSongAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textColor="#D49A2A"
                android:textSize="13sp"
                tools:text="RAGE AGAINST THE MACHINE" />
        </LinearLayout>

        <!-- Centered Radio Controls & 2-Row Icon Grid -->
        <LinearLayout
            android:id="@+id/themeControlsBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/themeNowPlayingGroup">

            <TextView
                android:id="@+id/themeRadioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="RADIO"
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/themeRadioState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:letterSpacing="0.1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:text="OFF"
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/themeVolumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.1"
                android:text="VOLUME"
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.sc.gtradio.VolumeBarView
                android:id="@+id/themeVolumeBar"
                android:layout_width="180dp"
                android:layout_height="22dp"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:id="@+id/themeIconRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="8dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/themeIconRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/themeRadioStationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.1"
                android:text="RADIO STATION"
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/themeActiveStationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text=""
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Left-Aligned Two-Column Pause Menu Controls & Horizontal Scrolling Station Strip -->
        <LinearLayout
            android:id="@+id/themeStripControlsBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/themeNowPlayingGroup">

            <!-- Row 1: Radio | On/Off -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/themeStripRadioLabel"
                    android:layout_width="152dp"
                    android:layout_height="wrap_content"
                    android:text="Radio"
                    android:textColor="#D49A2A"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/themeStripRadioState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="2dp"
                    android:paddingEnd="16dp"
                    android:text="Off"
                    android:textColor="#8E8E8E"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Row 2: Audio Level | Continuous Horizontal Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/themeStripVolumeLabel"
                    android:layout_width="152dp"
                    android:layout_height="wrap_content"
                    android:text="Audio Level"
                    android:textColor="#D49A2A"
                    android:textSize="18sp" />

                <com.sc.gtradio.VolumeBarView
                    android:id="@+id/themeStripVolumeBar"
                    android:layout_width="150dp"
                    android:layout_height="18dp" />
            </LinearLayout>

            <!-- Row 3: Radio Station | Station Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/themeStripStationLabel"
                    android:layout_width="152dp"
                    android:layout_height="wrap_content"
                    android:text="Radio Station"
                    android:textColor="#D49A2A"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/themeStripActiveStationName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text=""
                    android:textColor="#D49A2A"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Horizontal Scrolling Station Icons Row -->
            <HorizontalScrollView
                android:id="@+id/themeStripIconScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/themeStripIconRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
