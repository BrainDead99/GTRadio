<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RadioList">

    <!-- Standard GTRadio Layout (Fallback when Dynamic Theme is off or unavailable) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/defaultRadioContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/station_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/nowPlaying"
            app:layout_constraintTop_toTopOf="parent" />

        <fragment
            android:id="@+id/nowPlaying"
            android:name="com.sc.gtradio.NowPlayingFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout="@layout/fragment_nowplaying" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fullscreen Dynamic Theme Layout (gtaradio.net + Mockup layout) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dynamicThemeRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <ImageView
            android:id="@+id/themeBgA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/themeBgB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.0"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <!-- Series Header Title (e.g. San Andreas Radio) -->
        <TextView
            android:id="@+id/themeHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="16dp"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="San Andreas Radio"
            android:textColor="#D0E2F2"
            android:textSize="33sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Top-Left NOW PLAYING Metadata Block (Visible only during Songs & WCTR Shows) -->
        <LinearLayout
            android:id="@+id/themeNowPlayingGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/themeHeaderTitle">

            <TextView
                android:id="@+id/themeNowPlayingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="NOW PLAYING"
                android:textColor="#B8CFE6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/themeSongArt"
                android:layout_width="122dp"
                android:layout_height="122dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:background="#141414"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/themeSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:textColor="#D0E2F2"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="KILLING IN THE NAME" />

            <TextView
                android:id="@+id/themeSongArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:textColor="#B8CFE6"
                android:textSize="12sp"
                tools:text="RAGE AGAINST THE MACHINE" />

            <TextView
                android:id="@+id/themeSongAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:textColor="#8FA8BF"
                android:textSize="12sp"
                tools:text="RAGE AGAINST THE MACHINE" />
        </LinearLayout>

        <!-- Lower Centered Radio Controls & 2-Row Icon Grid -->
        <LinearLayout
            android:id="@+id/themeControlsBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/themeNowPlayingGroup">

            <TextView
                android:id="@+id/themeRadioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="RADIO"
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/themeRadioState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:letterSpacing="0.1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:text="OFF"
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/themeVolumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.1"
                android:text="VOLUME"
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.sc.gtradio.GtaVolumeBarView
                android:id="@+id/themeVolumeBar"
                android:layout_width="180dp"
                android:layout_height="22dp"
                android:layout_marginTop="6dp" />

            <!-- Station Icons Row 1 (6 stations) -->
            <LinearLayout
                android:id="@+id/themeIconRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="8dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- Station Icons Row 2 (5 stations) -->
            <LinearLayout
                android:id="@+id/themeIconRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/themeRadioStationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.1"
                android:text="RADIO STATION"
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/themeActiveStationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:text=""
                android:textColor="#6E849B"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
